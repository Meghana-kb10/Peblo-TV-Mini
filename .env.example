# ==============================================================================
# Peblo TV Mini - Environment Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Core Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="Peblo TV Mini API"
VERSION=1.0.0
SECRET_KEY=generate_a_random_high_entropy_secret_key_in_production_min_64_chars

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# For Docker Compose / Production PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@db:5432/peblo_tv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=peblo_tv
POSTGRES_PORT=5432

# For local development without Docker, you can optionally switch to SQLite:
# DATABASE_URL=sqlite:///./peblo_tv.db

# ------------------------------------------------------------------------------
# 3. Storage Abstraction Layer (Local Disk vs Cloudflare R2 / S3)
# ------------------------------------------------------------------------------
# Set to 'local' for filesystem storage or 'r2' for Cloudflare R2 / AWS S3
STORAGE_BACKEND=local
STORAGE_DIR=./storage

# Cloudflare R2 / S3 credentials (required only when STORAGE_BACKEND=r2)
R2_ENDPOINT_URL=https://<your-cloudflare-account-id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=peblo-tv-catalog
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_BASE_URL=https://catalog.peblo.tv

# ------------------------------------------------------------------------------
# 4. Content Reference & Seed File Paths
# ------------------------------------------------------------------------------
REFERENCE_PATH=./reference.json
SEED_PATH=./seed_shows.json

# ------------------------------------------------------------------------------
# 5. Service Port Mapping (Docker Compose)
# ------------------------------------------------------------------------------
API_PORT=8000
CMS_PORT=3000
VIEWER_PORT=3001

# ==============================================================================
# PRODUCTION SECRETS MANAGEMENT STRATEGY
# ==============================================================================
# In production, zero secrets are stored in plaintext, committed to Git, or baked into
# container images. Secrets are managed according to the following principles:
#
# 1. Centralized Secret Store & Runtime Injection:
#    All production secrets (PostgreSQL passwords, R2/S3 access keys, JWT signing keys)
#    are stored in a dedicated manager (AWS Secrets Manager, HashiCorp Vault, or Doppler).
#    Container task runners (e.g. AWS ECS / EKS or Google Cloud Run) ingest secrets at
#    runtime using IAM task roles and secret ARNs directly into environment variables.
#
# 2. IAM Roles & Ephemeral Workload Identity Over Static Credentials:
#    Instead of static R2 or S3 access keys, services assume temporary IAM credentials
#    (e.g., AWS IAM Roles for Service Accounts - IRSA, or Cloudflare API tokens restricted
#    strictly to the specific bucket's ObjectRead/ObjectWrite actions).
#
# 3. Automated Rotation & Least Privilege:
#    Database credentials and signing keys undergo automated rotation policies (e.g., every
#    90 days) managed by rotation Lambdas with zero-downtime dual-secret grace periods.
#    Access is strictly audited through CloudTrail / audit logs with no direct engineer access.
